NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Phase 2)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROUP=
STRIPE_PRICE_ELITE=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo login (optional) — set both to show a "Try the demo" button on /login.
# Credentials for a real coach account you've created and seeded with sample
# data. Omit either one and the button won't render.
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=

# Set to your own coach account's email to see an "Error log" link in the
# sidebar (/admin/errors) — the reported-errors feedback loop. Server-only,
# not exposed to the client beyond the boolean it gates.
ADMIN_EMAIL=

# Meta (Facebook/Instagram) Ads (Phase 4) — required for the "Connect Meta"
# flow in Settings. See docs/architecture-decisions.md and the Meta Ads setup
# checklist for how to get these.
META_APP_ID=
META_APP_SECRET=
# Graph API version this app targets, e.g. v21.0 — pin explicitly, don't
# float on Meta's default, since their default version changes over time.
META_API_VERSION=v21.0
# 32-byte key (base64 or hex, 64 hex chars) used to encrypt stored access
# tokens at the application layer, on top of Supabase's own encryption at
# rest and meta_connections' service-role-only RLS. Generate with:
#   openssl rand -hex 32
META_TOKEN_ENCRYPTION_KEY=
# Random shared value used only by Meta's one-time webhook verification GET.
META_WEBHOOK_VERIFY_TOKEN=
# Authorizes Vercel Cron to call /api/meta/sync (daily campaign/insights
# sync for every connected coach) — Vercel sends this automatically as
# `Authorization: Bearer $CRON_SECRET` for scheduled invocations once both
# this env var and vercel.json's cron entry exist. Generate with:
#   openssl rand -hex 32
CRON_SECRET=

# Full Circle Labs contact form (/api/leads) lead delivery — all optional.
# Email leads to your inbox (interim, before a CRM) via Resend (resend.com):
RESEND_API_KEY=
LEADS_TO_EMAIL=
# Optional custom sender; defaults to Resend's test address. Use an address on
# your own verified domain (e.g. leads@yourdomain.com) once the domain is set up.
LEADS_FROM_EMAIL=
# Forward leads to your CRM later (receives the lead as JSON):
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_SECRET=

# Sender for the CRM's own transactional emails (client invites, etc.) — shares
# RESEND_API_KEY above. Optional; defaults to Resend's test address. Use an
# address on your own verified domain once one is set up, e.g.
# "Full Circle CRM <hello@yourdomain.com>".
EMAIL_FROM=

# Zoom discovery-call automation. Create a Zoom Server-to-Server OAuth app,
# enable recording.completed, and point it at /api/zoom/webhook. These values
# are server-only and must never use a NEXT_PUBLIC_ prefix.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=

# AI transcription + implementation-ready project briefs.
OPENAI_API_KEY=
# Optional model overrides; the defaults below are used when omitted.
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_SUMMARY_MODEL=gpt-4o-mini
